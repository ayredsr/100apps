rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Public read access for the apps portfolio and content
      allow read: if true;
      // Only authenticated admins can write (secure closed writing)
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
